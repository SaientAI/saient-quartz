+    // Reference dump for the Quartz reimplementation. Token ids and the encoder output are dumped
+    // separately so the tokenizer and the 24-block encoder can be validated independently — if the
+    // embedding is wrong, this says immediately which of the two is at fault.
+    if (getenv("SAIENT_DUMP") != nullptr) {
+        auto dump_f32 = [](const char* path, const sd::Tensor<float>& t) {
+            if (t.empty()) { fprintf(stderr, "SAIENT_DUMP %s: empty\n", path); return; }
+            FILE* fp = fopen(path, "wb");
+            if (fp == nullptr) { fprintf(stderr, "SAIENT_DUMP %s: cannot open\n", path); return; }
+            const auto& s = t.shape();
+            uint32_t nd = (uint32_t)s.size();
+            fwrite("SQD1", 1, 4, fp); fwrite(&nd, sizeof(nd), 1, fp);
+            for (int64_t d : s) fwrite(&d, sizeof(d), 1, fp);
+            fwrite(t.data(), sizeof(float), (size_t)t.numel(), fp);
+            fclose(fp);
+            fprintf(stderr, "SAIENT_DUMP %s shape=[", path);
+            for (size_t i = 0; i < s.size(); ++i) fprintf(stderr, "%s%lld", i ? "," : "", (long long)s[i]);
+            fprintf(stderr, "] numel=%lld\n", (long long)t.numel());
+        };
+        dump_f32("/tmp/saient_ref/cond_crossattn.bin", embeds.cond.c_crossattn);
