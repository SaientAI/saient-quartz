+        if (!embeds.cond.c_t5_ids.empty()) {
+            FILE* fp = fopen("/tmp/saient_ref/cond_t5_ids.txt", "w");
+            if (fp != nullptr) {
+                for (int64_t i = 0; i < embeds.cond.c_t5_ids.numel(); ++i)
+                    fprintf(fp, "%d\n", embeds.cond.c_t5_ids.data()[i]);
+                fclose(fp);
+                fprintf(stderr, "SAIENT_DUMP cond_t5_ids n=%lld\n", (long long)embeds.cond.c_t5_ids.numel());
+            }
+        }
+        fflush(stderr);
+    }
