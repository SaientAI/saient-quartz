#version 450

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) readonly buffer InputBuffer {
    float input_values[];
};
layout(set = 0, binding = 1, std430) readonly buffer WeightBuffer {
    float weights[];
};
layout(set = 0, binding = 2, std430) writeonly buffer OutputBuffer {
    float output_values[];
};

layout(push_constant) uniform Dimensions {
    uint rows;
    uint width;
    float epsilon;
    uint padding;
} dimensions;

shared float partial[256];

void main() {
    uint row = gl_WorkGroupID.x;
    uint lane = gl_LocalInvocationID.x;
    if (row >= dimensions.rows) {
        return;
    }

    uint row_offset = row * dimensions.width;
    float sum_squares = 0.0;
    for (uint column = lane; column < dimensions.width; column += 256) {
        float value = input_values[row_offset + column];
        sum_squares += value * value;
    }
    partial[lane] = sum_squares;
    barrier();

    for (uint offset = 128; offset > 0; offset >>= 1) {
        if (lane < offset) {
            partial[lane] += partial[lane + offset];
        }
        barrier();
    }
    float inverse_rms = inversesqrt(
        partial[0] / float(dimensions.width) + dimensions.epsilon);

    for (uint column = lane; column < dimensions.width; column += 256) {
        output_values[row_offset + column] =
            input_values[row_offset + column] * inverse_rms * weights[column];
    }
}
